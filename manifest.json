{
    "manifest_version": 3,
    "name": "AI News Daily",
    "version": "1.0",
    "description": "每日AI新闻聚合器",
    "permissions": [
      "storage",
      "alarms"
    ],
    "host_permissions": [ 
      "https://*/*"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    }
}